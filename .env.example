# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin used to build approved Auth redirect URLs
# Production: https://orqelio.kz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase secret key used only by the webhook inbox writer
SUPABASE_SECRET_KEY=

# Server-only, base64-encoded 32-byte key used for AES-256-GCM
YCLIENTS_CREDENTIALS_ENCRYPTION_KEY=

# Server-only Altegio Marketplace activation and access verification
ALTEGIO_APPLICATION_ID=
ALTEGIO_PARTNER_TOKEN=
ALTEGIO_USER_TOKEN=
